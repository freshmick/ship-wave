@@ -0,0 +1,27 @@
+import { expect, test } from 'vitest';
+import { buildRevenueTrendOptions } from './revenue-trend';
+
+test('builds one line of revenue per day, oldest first', () => {
+  const options = buildRevenueTrendOptions(
+    [
+      { date: '2026-11-03', amount: 31 },
+      { date: '2026-11-02', amount: 18.5 },
+    ],
+    'USD',
+  );
+
+  expect(options.series).toEqual([
+    {
+      type: 'line',
+      name: 'USD',
+      data: [
+        [Date.parse('2026-11-02'), 18.5],
+        [Date.parse('2026-11-03'), 31],
+      ],
+    },
+  ]);
+});
+
+test('no points gives an empty line', () => {
+  expect(buildRevenueTrendOptions([], 'USD').series).toEqual([{ type: 'line', name: 'USD', data: [] }]);
+});
diff --git a/src/lib/revenue-trend.ts b/src/lib/revenue-trend.ts
new file mode 100644
index 000000000..8e69a3af3
--- /dev/null
+++ b/src/lib/revenue-trend.ts
@@ -0,0 +1,25 @@
+import type { Options } from 'highcharts';
+
+export interface RevenuePoint {
+  date: string;
+  amount: number;
+}
+
+// Chart options for the revenue trend: one line of revenue per day, oldest first.
+export function buildRevenueTrendOptions(points: RevenuePoint[], currency: string): Options {
+  const sorted = [...points].sort((a, b) => a.date.localeCompare(b.date));
+
+  return {
+    chart: { type: 'line' },
+    title: { text: undefined },
+    xAxis: { type: 'datetime' },
+    yAxis: { title: { text: currency } },
+    series: [
+      {
+        type: 'line',
+        name: currency,
+        data: sorted.map(point => [Date.parse(point.date), point.amount]),
+      },
+    ],
+  };
+}
