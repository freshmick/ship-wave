@@ -0,0 +1,19 @@
+// Tells the team's chat channel that someone joined with the access code.
+// Does nothing when no webhook is configured. A failed post never fails the join.
+export async function notifyTeamJoin(teamName: string, username: string) {
+  const url = process.env.TEAM_JOIN_WEBHOOK_URL;
+
+  if (!url) {
+    return;
+  }
+
+  try {
+    await fetch(url, {
+      method: 'POST',
+      headers: { 'content-type': 'application/json' },
+      body: JSON.stringify({ text: `${username} joined the team ${teamName}.` }),
+    });
+  } catch {
+    // The join has already succeeded.
+  }
+}
