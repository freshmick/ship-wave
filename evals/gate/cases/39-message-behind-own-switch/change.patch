diff --git a/src/lib/team-notify.test.ts b/src/lib/team-notify.test.ts
new file mode 100644
index 000000000..37fcffbea
--- /dev/null
+++ b/src/lib/team-notify.test.ts
@@ -0,0 +1,40 @@
+import { afterEach, beforeEach, expect, test, vi } from 'vitest';
+import { notifyTeamJoin } from './team-notify';
+
+const fetchMock = vi.fn();
+
+beforeEach(() => {
+  fetchMock.mockReset();
+  fetchMock.mockResolvedValue({ ok: true });
+  vi.stubGlobal('fetch', fetchMock);
+});
+
+afterEach(() => {
+  vi.unstubAllGlobals();
+  delete process.env.TEAM_JOIN_WEBHOOK_URL;
+});
+
+test('posts who joined to the configured webhook', async () => {
+  process.env.TEAM_JOIN_WEBHOOK_URL = 'https://chat.example.com/hooks/abc';
+
+  await notifyTeamJoin('Growth', 'dana');
+
+  expect(fetchMock).toHaveBeenCalledWith('https://chat.example.com/hooks/abc', {
+    method: 'POST',
+    headers: { 'content-type': 'application/json' },
+    body: JSON.stringify({ text: 'dana joined the team Growth.' }),
+  });
+});
+
+test('does nothing when no webhook is configured', async () => {
+  await notifyTeamJoin('Growth', 'dana');
+
+  expect(fetchMock).not.toHaveBeenCalled();
+});
+
+test('a failed post does not throw', async () => {
+  process.env.TEAM_JOIN_WEBHOOK_URL = 'https://chat.example.com/hooks/abc';
+  fetchMock.mockRejectedValue(new Error('network down'));
+
+  await expect(notifyTeamJoin('Growth', 'dana')).resolves.toBeUndefined();
+});
diff --git a/src/lib/team-notify.ts b/src/lib/team-notify.ts
